{
  "info": {
    "_postman_id": "c1f32a89-7e43-4bf3-9d0b-93214589d8ef",
    "name": "University Research Opportunity Portal API",
    "description": "Postman collection for University Research Opportunity Portal REST API built with NestJS, TypeScript, MongoDB, and Mongoose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "opportunityId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Opportunity (POST /api/opportunities - 201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData._id) {",
              "    pm.collectionVariables.set('opportunityId', jsonData._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Quantum Computing and Error Mitigation\",\n  \"description\": \"Research on quantum algorithms and error mitigation for noisy intermediate-scale quantum devices.\",\n  \"researchArea\": \"Quantum Information Science\",\n  \"facultyMemberName\": \"Dr. Richard Feynman\",\n  \"department\": \"Physics\",\n  \"requiredSkills\": [\"Linear Algebra\", \"Python\", \"Qiskit\"],\n  \"numberOfPositions\": 2,\n  \"applicationDeadline\": \"2026-12-15T23:59:59.000Z\",\n  \"status\": \"Open\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/opportunities",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities"]
        }
      }
    },
    {
      "name": "2. Create Opportunity - Validation Error (POST /api/opportunities - 400 Bad Request)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"numberOfPositions\": -1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/opportunities",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities"]
        }
      }
    },
    {
      "name": "3. Get All Opportunities (GET /api/opportunities - 200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/opportunities",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities"]
        }
      }
    },
    {
      "name": "4. Get Opportunities Filtered by Status (GET /api/opportunities?status=Open - 200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/opportunities?status=Open",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities"],
          "query": [
            {
              "key": "status",
              "value": "Open"
            }
          ]
        }
      }
    },
    {
      "name": "5. Get Opportunity by ID (GET /api/opportunities/:id - 200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/opportunities/{{opportunityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities", "{{opportunityId}}"]
        }
      }
    },
    {
      "name": "6. Update Opportunity / Mark as Closed (PUT /api/opportunities/:id - 200 OK)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Closed\",\n  \"numberOfPositions\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/opportunities/{{opportunityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities", "{{opportunityId}}"]
        }
      }
    },
    {
      "name": "7. Delete Opportunity (DELETE /api/opportunities/:id - 200 OK)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/opportunities/{{opportunityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities", "{{opportunityId}}"]
        }
      }
    },
    {
      "name": "8. Get Deleted Opportunity - Returns 404 (GET /api/opportunities/:id - 404 Not Found)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/opportunities/{{opportunityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities", "{{opportunityId}}"]
        }
      }
    }
  ]
}
