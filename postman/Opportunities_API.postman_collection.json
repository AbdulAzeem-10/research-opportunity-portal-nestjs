{
  "info": {
    "_postman_id": "c1f32a89-7e43-4bf3-9d0b-93214589d8ef",
    "name": "Research Opportunity Portal API",
    "description": "Postman collection for testing Research Opportunities API built with NestJS, MongoDB, and Mongoose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "opportunityId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Opportunity (POST - 201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData._id) {",
              "    pm.collectionVariables.set('opportunityId', jsonData._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Deep Learning in Medical Imaging\",\n  \"description\": \"Assist in developing generative diffusion models for MRI scan reconstruction.\",\n  \"department\": \"Biomedical Engineering\",\n  \"professor\": \"Dr. Elena Rostova\",\n  \"status\": \"Open\",\n  \"category\": \"Artificial Intelligence\",\n  \"requirements\": [\"Python\", \"PyTorch\", \"Linear Algebra\"],\n  \"deadline\": \"2026-11-30T23:59:59.000Z\",\n  \"stipend\": \"$1,800 / month\",\n  \"location\": \"Hybrid\",\n  \"contactEmail\": \"elena.rostova@univ.edu\",\n  \"openSpots\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/opportunities",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities"]
        }
      }
    },
    {
      "name": "2. Create Opportunity - Validation Error (POST - 400 Bad Request)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"contactEmail\": \"not-a-valid-email\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/opportunities",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities"]
        }
      }
    },
    {
      "name": "3. Get All Opportunities (GET - 200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/opportunities",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities"]
        }
      }
    },
    {
      "name": "4. Get Opportunities with Filter (GET - 200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/opportunities?status=Open",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities"],
          "query": [
            {
              "key": "status",
              "value": "Open"
            }
          ]
        }
      }
    },
    {
      "name": "5. Get Opportunity by ID (GET - 200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/opportunities/{{opportunityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities", "{{opportunityId}}"]
        }
      }
    },
    {
      "name": "6. Update Opportunity / Mark as Closed (PUT - 200 OK)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Closed\",\n  \"openSpots\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/opportunities/{{opportunityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities", "{{opportunityId}}"]
        }
      }
    },
    {
      "name": "7. Delete Opportunity (DELETE - 200 OK)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/opportunities/{{opportunityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities", "{{opportunityId}}"]
        }
      }
    },
    {
      "name": "8. Get Deleted Opportunity - Must Return 404 (GET - 404 Not Found)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/opportunities/{{opportunityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["opportunities", "{{opportunityId}}"]
        }
      }
    }
  ]
}
